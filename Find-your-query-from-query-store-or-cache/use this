DECLARE @text NVARCHAR(MAX) = '%#postids%'

SELECT 
    qsq.query_id,
    qsq.last_execution_time,
    qsqt.query_sql_text,
    AVG(qsrs.avg_duration) / 1000000 AS avg_execution_time_s
FROM 
    sys.query_store_query qsq
INNER JOIN 
    sys.query_store_query_text qsqt ON qsq.query_text_id = qsqt.query_text_id
INNER JOIN 
    sys.query_store_runtime_stats qsrs 
    ON qsrs.last_execution_time = qsq.last_execution_time -- qsq.query_id = qsrs.query_id
WHERE 
    qsqt.query_sql_text LIKE @text -- '%YourProcedureText%'
GROUP BY 
    qsq.query_id,
    qsq.last_execution_time,
    qsqt.query_sql_text
ORDER BY 
    avg_execution_time_s;